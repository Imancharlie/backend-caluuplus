# Django Production Settings
SECRET_KEY=your-secret-key-here-generate-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=caluu.mipt.co.tz,localhost

# Database Configuration (PostgreSQL)
DB_NAME=caluuplus
DB_USER=caluuplus_user
DB_PASSWORD=your-postgres-password-here
DB_HOST=localhost
DB_PORT=5432

# API Keys
# Do not commit real keys. Copy to .env.production and fill in locally.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Must be a model your key can actually reach - claude-3-* names return 404 on
# many workspaces. List the ones you can reach with:
#   curl https://api.anthropic.com/v1/models -H "x-api-key: $ANTHROPIC_API_KEY"
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=your-gemini-api-key

# Email Configuration (Optional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=no-reply@caluuplus.com

# Backup Configuration
BACKUP_NOTIFY_EMAIL=kodinsoftwares@gmail.com
OPPORTUNITY_REVIEW_NOTIFY_EMAIL=kodinsoftwares@gmail.com
OPPORTUNITY_ADMIN_REVIEW_URL=https://caluu.kodin.co.tz/admin/opportunities

# Redis (cache + rate limiter)
REDIS_URL=redis://127.0.0.1:6379/1
