# Django Production Settings
SECRET_KEY=your-secret-key-here-generate-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=caluu.mipt.co.tz,localhost

# Database Configuration (PostgreSQL)
DB_NAME=caluuplus
DB_USER=caluuplus_user
DB_PASSWORD=your-postgres-password-here
DB_HOST=localhost
DB_PORT=5432

# API Keys
# Do not commit real keys. Copy to .env and fill in locally.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Must be a model your key can actually reach - claude-3-* names return 404 on
# many workspaces. List the ones you can reach with:
#   curl https://api.anthropic.com/v1/models -H "x-api-key: $ANTHROPIC_API_KEY"
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=your-gemini-api-key

# Gemini API Configuration (FALLBACK AI Provider)
# Only used if Anthropic is unavailable or fails to initialize
# GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic Model Settings
ANTHROPIC_MIN_REQUEST_INTERVAL=3

# Gemini Model Settings (if used as fallback)
GEMINI_MODEL=gemini-flash-latest
GEMINI_ENABLE_WEB_SEARCH=false
GEMINI_THINKING_BUDGET=0
GEMINI_THINKING_BUDGET_CRITICAL=384
GEMINI_OUTPUT_HEADROOM=512
GEMINI_MAX_RETRIES=2

# Pricing Configuration
ANTHROPIC_INPUT_USD_PER_TOKEN=0.00000025
ANTHROPIC_OUTPUT_USD_PER_TOKEN=0.00000125
USD_TO_TSH_RATE=2700

# Redis Configuration (Optional - for caching)
# REDIS_URL=redis://127.0.0.1:6379/1

# Database Configuration (Optional - for PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Firebase Configuration (Optional - for push notifications)
# Firebase credentials should be in firebase-credentials.json file
